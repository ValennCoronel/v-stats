# ==========================================
# VARIABLES DE ENTORNO DEL FRONTEND (EXPO)
# ==========================================
# Nota: Para que Expo pueda leer estas variables, siempre deben comenzar con
# "EXPO_PUBLIC_"

# 1. ENTORNO LOCAL WEB (navegador en tu computadora)
EXPO_PUBLIC_API_URL_WEB=http://localhost:3000

# 2. ENTORNO LOCAL ANDROID EMULATOR
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3000

# 3. ENTORNO LOCAL GENERICO / respaldo
EXPO_PUBLIC_API_URL=http://localhost:3000

# 4. ENTORNO DE PRODUCCION (Conexion a Vercel)
# EXPO_PUBLIC_API_URL=https://v-stats-imgb.vercel.app
