# ==========================================
# VARIABLES DE ENTORNO DEL FRONTEND (EXPO)
# ==========================================
# Nota: Para que Expo pueda leer estas variables, siempre deben comenzar con "EXPO_PUBLIC_"

# 1. ENTORNO LOCAL (Conexión a tu Docker / PC)
# Descomenta esta línea cuando estés desarrollando en tu computadora.
EXPO_PUBLIC_API_URL=http://localhost:3000

# 2. ENTORNO DE PRODUCCIÓN (Conexión a Vercel)
# Descomenta esta línea cuando vayas a generar el APK o subir a producción.
# Asegúrate de reemplazar "tu-proyecto.vercel.app" por la URL real de tu backend.
#EXPO_PUBLIC_API_URL=https://v-stats-imgb.vercel.app

